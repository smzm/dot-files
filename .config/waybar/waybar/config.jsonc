{
    "position": "bottom",
    "height": 37,
    "margin-bottom": 0,
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,
    "spacing": 2,

    "modules-left": ["hyprland/workspaces", "custom/lyrics"],
    "modules-center": ["clock", "custom/weather"],
    "modules-right": [
        "keyboard-state",
        "hyprland/language",
        "group/volume",
        "bluetooth",
        "cpu",
        "memory",
        "custom/gpu-temp",
        "custom/iplocation",
        "custom/network-usage",
        "tray",
        "custom/power"
    ],

    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "on-scroll-up": "hyprctl dispatch \"hl.dsp.focus({ workspace = 'e+1' })\"",
        "on-scroll-down": "hyprctl dispatch \"hl.dsp.focus({ workspace = 'e-1' })\"",
        "all-outputs": true,
        "sort-by-number": true,
        "persistent-workspaces": {
            "*": 5
        }
    },
    "hyprland/window": {
        "format": "  {}",
        "max-length": 50,
        "separate-outputs": true,
        "rewrite": {
            "(.*) — Mozilla Firefox": "󰈹  $1",
            "(.*) - fish": "  $1",
            "(.*) - zsh": "  $1",
            "(.*) - nvim": "  $1",
            "nvim": "  nvim",
            "kitty": "  kitty",
            "": "  desktop"
        }
    },
    "hyprland/submap": {
        "format": "{icon} {submap}",
        "max-length": 8,
        "tooltip": false,
        "icons": {
            "resize": "",
            "pause": ""
        }
    },
    "hyprland/language": {
        "format": "{}",
        "format-en": "US",
        "format-fa": "FA",
        "tooltip": true,
        "tooltip-format": "{long}",
        "on-click": "hyprctl switchxkblayout mosart-semi.-mi-wireless-combo next"
    },
    "tray": {
        "icon-size": 15,
        "spacing": 10
    },

    "network": {
        "format-wifi": "󰤨  {essid} ({signalStrength}%)",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤭  offline",
        "tooltip-format-wifi": "󰤨  {essid}\nSignal: {signalStrength}%\nFreq: {frequency}MHz\nIP: {ipaddr}",
        "tooltip-format-ethernet": "󰈀  {ifname}\nIP: {ipaddr}",
        "on-click": "nmrs",
        "interval": 10
    },
    "keyboard-state": {
        "numlock": false,
        "capslock": true,
        "scrolllock": false,
        "format": "{icon}",
        "format-icons": {
            "locked": "CAPS",
            "unlocked": ""
        }
    },
    "clock": {
        "format": "󰥔  {:%a, %d. %b | %I:%M %p}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#cdd6f4'><b>{}</b></span>",
                "days": "<span color='#cdd6f4'>{}</span>",
                "weeks": "<span color='#89b4fa'>W{}</span>",
                "weekdays": "<span color='#a6e3a1'><b>{}</b></span>",
                "today": "<span color='#f38ba8'><b>{}</b></span>"
            }
        }
    },
    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-muted": "",
        "format-icons": {
            "default": ["", ""]
        },
        "scroll-step": 1,
        "ignored-sinks": ["Easy Effects Sink"],
        "on-click": "pavucontrol"
    },
    "pulseaudio/slider": {
        "min": 0,
        "max": 100,
        "orientation": "horizontal"
    },
    "group/volume": {
        "orientation": "horizontal",
        "modules": ["pulseaudio", "pulseaudio/slider"]
    },

    "bluetooth": {
        "format": "󰂯 {status}",
        "format-connected": "󰂱  {device_alias}",
        "format-connected-battery": "󰂱  {device_alias} ({device_battery_percentage}%)",
        "format-disabled": "󰂲  off",
        "tooltip-format": "{controller_alias}\n{num_connections} connected",
        "tooltip-format-connected": "{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "on-click": "blueman-manager",
        "interval": 10
    },
    "cpu": {
        "interval": 10,
        "format": "󰻠 {usage}%",
        "tooltip-format": "CPU: {usage}%\nLoad: {load}",
        "on-click": "kitty -- btop",
        "states": {
            "warning": 70,
            "critical": 90
        }
    },
    "temperature": {
        "critical-threshold": 80,
        "interval": 5,
        "format": "{icon} {temperatureC}°C",
        "format-critical": "󰸁  {temperatureC}°C",
        "tooltip-format": "Temperature: {temperatureC}°C",
        "format-icons": ["󱃃", "󰔏", "󱃂"]
    },

    "memory": {
        "interval": 10,
        "format": "󰍛 {percentage}%",
        "tooltip-format": "RAM: {used:0.1f}G / {total:0.1f}G\nSwap: {swapUsed:0.1f}G / {swapTotal:0.1f}G",
        "on-click": "kitty -- btop",
        "states": {
            "warning": 70,
            "critical": 90
        }
    },
    "custom/bluelight": {
        "format": "{}",
        "exec": "~/.config/waybar/custom_modules/bluelight-toggle.sh --status",
        "on-click": "~/.config/waybar/custom_modules/bluelight-toggle.sh&& pkill -RTMIN+8 waybar",
        "signal": 8,
        "tooltip": "Toggle blue light filter",
        "interval": 10
    },
    "custom/gpu-temp": {
        "exec": "~/.config/waybar/custom_modules/gpu-temp.sh",
        "interval": 10,
        "return-type": "json",
        "on-click": "kitty --title nvidia-smi nvidia-smi"
    },
    "custom/power": {
        "format": "󰐥",
        "tooltip": "Power menu",
        "on-click": "~/.config/waybar/custom_modules/power_menu.sh"
    },

    "group/media": {
        "orientation": "horizontal",
        "modules": [
            "custom/media-animation",
            "custom/media-now-playing",
            "custom/media-time"
        ]
    },
    "custom/media-now-playing": {
        "exec": "~/.config/waybar/custom_modules/media/media-now-playing.sh",
        "escape": true,
        "tooltip": false,
        "on-click": "playerctl play-pause",
        "on-click-middle": "playerctl previous",
        "on-click-right": "playerctl next"
    },
    "custom/media-animation": {
        "exec": "~/.config/waybar/custom_modules/media/media-animation.sh",
        "tooltip": false
    },
    "custom/media-time": {
        "exec": "~/.config/waybar/custom_modules/media/media-time.sh",
        "escape": true,
        "interval": 1,
        "tooltip": false
    },
    "custom/iplocation": {
        "exec": "~/.config/waybar/custom_modules/geo_ip_location.sh",
        "return-type": "json",
        "interval": 60,
        "tooltip": true
    },
    "custom/weather": {
        "exec": "~/.config/waybar/custom_modules/weather.sh",
        "return-type": "json",
        "interval": 900,
        "tooltip": true,
        "format": "{}"
    },
    "custom/network-usage": {
        "exec": "~/.config/waybar/custom_modules/net-usage-counter.sh",
        "return-type": "json",
        "interval": 25,
        "tooltip": true
    },

    "custom/lyrics": {
        "return-type": "json",
        "format": "{icon} {0}",
        "hide-empty-text": true,
        "exec-if": "which waybar-lyric",
        "exec": "waybar-lyric --quiet",
        "on-click": "waybar-lyric play-pause",
        "format-icons": {
            "playing": "",
            "paused": "",
            "lyric": "",
            "music": "󰝚",
            "no_lyric": "",
            "getting": ""
        }
    }
}
