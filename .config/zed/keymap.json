// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-l": "workspace::ActivatePaneRight",
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "shift shift": "file_finder::Toggle",
    },
  },
  {
    "context": "Editor",
    "bindings": {
      "alt-e": "editor::Hover",
      "alt-x": "diagnostics::Deploy",
    },
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "j k": "vim::NormalBefore",
      "] [": ["workspace::SendKeystrokes", "{"],
      "0 9": ["workspace::SendKeystrokes", "("],
      "; ;": ["workspace::SendKeystrokes", ":"],
    },
  },
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      "backspace": ["workspace::SendKeystrokes", "d i w h escape"],
      ";": ["workspace::SendKeystrokes", ":"],
      "shift-l": "pane::ActivateNextItem",
      "shift-h": "pane::ActivatePreviousItem",
      "alt-k": "editor::MoveLineUp",
      "alt-j": "editor::MoveLineDown",
      "tab": "project_panel::ToggleFocus",
      "=": "outline_panel::Toggle",
      "shift-j": ["workspace::SendKeystrokes", "1 0 j"],
      "shift-k": ["workspace::SendKeystrokes", "1 0 k"],
      "ctrl+o": "outline_panel::Toggle",
      "x": ["workspace::SendKeystrokes", "\" _ x"],
      "\\": "agent::Toggle",
      "F12": "terminal_panel::Toggle",
      "s": "vim::HelixJumpToWord",
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      "F12": "terminal_panel::Toggle",
      "alt-enter": "workspace::NewTerminal",
      "alt-h": "pane::ActivatePreviousItem",
      "alt-l": "pane::ActivateNextItem",
    },
  },
  {
    "context": "Editor && vim_mode == visual",
    "bindings": {
      "x": ["workspace::SendKeystrokes", "\" _ x"],
      "alt-k": "editor::MoveLineUp",
      "alt-j": "editor::MoveLineDown",
    },
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "tab": "project_panel::ToggleFocus",
      "a": "project_panel::NewFile",
      "A": "project_panel::NewDirectory",
      "r": "project_panel::Rename",
      "d": ["project_panel::Trash", { "skip_prompt": false }],
      "x": "project_panel::Cut",
      "y": "project_panel::Copy",
      "Y": "workspace::CopyPath",
      "p": "project_panel::Paste",
      "u": "project_panel::Undo",
      "ctrl-r": "project_panel::Redo",
      "escape": "menu::Cancel",
    },
  },
  {
    "context": "AgentPanel > Editor",
    "bindings": {
      "pageup": "agent::ScrollOutputToPreviousMessage",
      "pagedown": "agent::ScrollOutputToNextMessage",
      "alt-tab": "multi_workspace::NextThread",
      "tab": "agent::CycleModeSelector",
    },
  },
]
