//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "context_servers": {
    "mcp-server-playwright": {
      "enabled": true,
      "remote": false,
      "settings": {},
    },
  },
  "show_edit_predictions": true,
  "agent": {
    "default_model": {
      "effort": "medium",
      "provider": "apinex",
      "model": "free/deepseek-v4.1-flash",
      "enable_thinking": true,
    },
    "favorite_models": [],
    "model_parameters": [],
  },
  "language_models": {
    "openai_compatible": {
      "apinex": {
        "api_url": "https://api.apinex.bond/v1",
        "available_models": [
          {
            "name": "free/qwen-3.8-max",
            "max_tokens": 200000,
            "max_output_tokens": 32000,
            "max_completion_tokens": 200000,
            "reasoning_effort": "medium",
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": false,
              "prompt_cache_key": false,
              "chat_completions": true,
              "interleaved_reasoning": false,
              "max_tokens_parameter": false,
            },
          },
          {
            "name": "free/deepseek-v4.1-flash",
            "max_tokens": 200000,
            "max_output_tokens": 32000,
            "max_completion_tokens": 200000,
            "reasoning_effort": "medium",
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": false,
              "prompt_cache_key": false,
              "chat_completions": true,
              "interleaved_reasoning": false,
              "max_tokens_parameter": false,
            },
          },
        ],
      },
      "OrcaRouter": {
        "api_url": "https://api.orcarouter.ai/v1/chat/completions",
        "available_models": [
          {
            "name": "z-ai/glm-5.3-flash-free",
            "max_tokens": 200000,
            "max_output_tokens": 32000,
            "max_completion_tokens": 200000,
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": false,
              "prompt_cache_key": false,
              "chat_completions": true,
              "interleaved_reasoning": false,
              "max_tokens_parameter": false,
            },
          },
        ],
      },
    },
    "opencode": {
      "show_zen_models": true,
      "show_go_models": false,
    },
  },
  "agent_servers": {},
  "edit_predictions": {
    "mercury": {
      "prediction_debounce": 300,
    },
    "zed": {
      "prediction_debounce": 0,
    },
    "allow_data_collection": "no",
    "disabled_globs": [".env"],
    "mode": "eager",
    "codestral": {
      "model": "codestral-latest",
      "max_tokens": 150,
      "prediction_debounce": 250,
    },
    "provider": "mercury",
  },
  "cli_default_open_behavior": "existing_window",
  "proxy": "",
  "zoomed_padding": true,
  "active_pane_modifiers": {
    "border_size": 0.0,
    "inactive_opacity": 1.0,
  },
  "use_system_window_tabs": false,
  "tabs": {
    "file_icons": true,
    "git_status": false,
  },
  "title_bar": {
    "button_layout": "platform_default",
    "show_menus": false,
    "show_user_menu": true,
    "show_sign_in": true,
    "show_onboarding_banner": true,
    "show_project_items": true,
    "show_branch_name": true,
    "show_branch_status_icon": false,
  },
  "terminal": {
    "toolbar": {
      "breadcrumbs": false,
    },
    "copy_on_select": true,
    "option_as_meta": false,
    "font_weight": 300.0,
    "font_size": 15.0,
    "show_count_badge": false,
    "button": true,
  },
  "status_bar": {
    "line_endings_button": false,
    "cursor_position_button": false,
    "active_language_button": true,
  },
  "project_panel": {
    "hide_hidden": false,
    "hide_root": true,
    "git_status_indicator": false,
    "diagnostic_badges": true,
    "bold_folder_labels": false,
    "indent_size": 20.0,
    "hide_gitignore": false,
    "button": true,
  },
  "inline_code_actions": false,
  "diagnostics": {
    "button": true,
    "inline": {
      "enabled": false,
    },
  },
  "inlay_hints": {
    "show_background": true,
    "enabled": false,
  },
  "indent_guides": {
    "background_coloring": "disabled",
    "coloring": "fixed",
    "active_line_width": 1,
    "line_width": 1,
  },
  "preferred_line_length": 110,
  "show_wrap_guides": true,
  "soft_wrap": "editor_width",
  "vim": {
    "use_smartcase_find": true,
  },
  "toolbar": {
    "code_actions": true,
    "agent_review": true,
    "selections_menu": true,
    "breadcrumbs": true,
  },
  "minimap": {
    "thumb": "hover",
    "show": "auto",
  },
  "gutter": {
    "min_line_number_digits": 4,
    "line_numbers": true,
  },
  "autoscroll_on_clicks": true,
  "sticky_scroll": {
    "enabled": true,
  },
  "ui_font_weight": 400.0,
  "ui_font_family": "Exo",
  "buffer_line_height": "comfortable",
  "telemetry": {
    "diagnostics": true,
    "metrics": false,
    "anthropic_retention": false,
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Colored Zed Icons Theme Dark",
    "dark": "Colored Zed Icons Theme Dark",
  },
  "autosave": "on_focus_change",
  "format_on_save": "on",
  "buffer_font_weight": 300.0,
  "buffer_font_family": "SF Mono",
  "session": {
    "trust_all_worktrees": true,
  },
  "vim_mode": true,
  "multi_cursor_modifier": "cmd_or_ctrl",
  "ui_font_size": 16.0,
  "buffer_font_size": 15.0,
  "lsp": {
    "basedpyright": {
      "settings": {
        "basedpyright.analysis": {
          "diagnosticMode": "openFilesOnly",
          "typeCheckingMode": "basic",
        },
      },
    },
  },
  "theme": {
    "mode": "dark",
    "light": "v0-light",
    "dark": "Modern Vesper",
  },
  "auto_install_extensions": {
    "html": true,
    "git-firefly": true,
    "toml": true,
    "dockerfile": true,
    "sql": true,
    "make": true,
    "lua": true,
    "latex": true,
    "rich-vesper": true,
    "catppuccin-blur": true,
    "colored-zed-icons-theme": true,
    "rainbow-csv": true,
    "env": true,
    "color-highlight": true,
    "rust-snippets": true,
    "mcp-server-playwright": true,
    "latex-snippets": true,
    "rust-glancer": true,
    "rust-analyzer": true,
  },
}
