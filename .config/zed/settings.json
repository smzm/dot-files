// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "show_edit_predictions": false,
  "agent": {
    "inline_assistant_model": {
      "provider": "zed.dev",
      "model": "gpt-5.6-sol",
      "enable_thinking": false,
    },
    "default_model": {
      "effort": "medium",
      "provider": "zed.dev",
      "model": "gpt-5.6-luna",
      "enable_thinking": true,
    },
    "favorite_models": [
      {
        "provider": "zed.dev",
        "model": "gpt-5.6-sol",
        "enable_thinking": true,
        "effort": "medium"
      },
      {
        "provider": "OrcaRouter",
        "model": "z-ai/glm-5.3-flash-free",
        "enable_thinking": true,
        "effort": "medium"
      },
      {
        "provider": "zed.dev",
        "model": "gpt-5.6-luna",
        "enable_thinking": true,
        "effort": "medium"
      },
      {
        "provider": "zed.dev",
        "model": "claude-sonnet-5",
        "enable_thinking": true,
        "effort": "high"
      },
      {
        "provider": "zed.dev",
        "model": "claude-opus-5",
        "enable_thinking": true,
        "effort": "high"
      },
      {
        "provider": "codeCraftApi",
        "model": "gpt-5.6-sol",
        "enable_thinking": true,
        "effort": "medium"
      },
      {
        "provider": "codeCraftApi",
        "model": "qwen3.8-max",
        "enable_thinking": true,
        "effort": "medium"
      }
    ],
    "model_parameters": [],
  },
  "language_models": {
    "opencode": {
      "show_zen_models": true,
      "show_go_models": false,
    },
    "openai_compatible": {
      "codeCraftApi": {
        "api_url": "https://codecraftapi.com/v1",
        "available_models": [
          {
            "name": "gpt-5.6-sol",
            "max_tokens": 100000,
            "max_output_tokens": 32000,
            "max_completion_tokens": 100000,
            "reasoning_effort": "medium",
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": false,
              "prompt_cache_key": false,
              "chat_completions": true,
              "interleaved_reasoning": false,
              "max_tokens_parameter": false
            }
          },
          {
            "name": "qwen3.8-max",
            "max_tokens": 1000000,
            "max_output_tokens": 32000,
            "max_completion_tokens": 1000000,
            "reasoning_effort": "medium",
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": false,
              "prompt_cache_key": false,
              "chat_completions": true,
              "interleaved_reasoning": false,
              "max_tokens_parameter": false
            }
          }
        ]
      },
      "OrcaRouter": {
        "api_url": "https://api.orcarouter.ai/v1",
        "available_models": [
          {
            "name": "z-ai/glm-5.3-flash-free",
            "max_tokens": 1000000,
            "max_output_tokens": 32000,
            "max_completion_tokens": 1000000,
            "reasoning_effort": "medium",
            "capabilities": {
              "tools": true,
              "images": true,
              "parallel_tool_calls": false,
              "prompt_cache_key": false,
              "chat_completions": true,
              "interleaved_reasoning": false,
              "max_tokens_parameter": false,
            },
          },
          {
            "name": "deepseek/deepseek-v4-flash-free",
            "max_tokens": 1000000,
            "max_output_tokens": 32000,
            "max_completion_tokens": 1000000,
            "reasoning_effort": "medium",
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": false,
              "prompt_cache_key": false,
              "chat_completions": true,
              "interleaved_reasoning": false,
              "max_tokens_parameter": false,
            },
          },
          {
            "name": "orcarouter/free",
            "max_tokens": 1000000,
            "max_output_tokens": 32000,
            "max_completion_tokens": 1000000,
            "reasoning_effort": "medium",
            "capabilities": {
              "tools": true,
              "images": true,
              "parallel_tool_calls": false,
              "prompt_cache_key": false,
              "chat_completions": true,
              "interleaved_reasoning": false,
              "max_tokens_parameter": false,
            },
          },
        ],
      },
    },
  },
  "agent_servers": {
    "opencode": {
      "default_config_options": {
        "mode": "build",
        "effort": "medium",
        "model": "opencode/muse-spark-1.3-contributor-free",
      },
      "type": "registry",
    },
  },

  "edit_predictions": {
    "allow_data_collection": "no",
    "disabled_globs": [".env"],
    "mode": "eager",
    "codestral": {
      "model": "codestral-latest",
      "max_tokens": 150,
      "prediction_debounce": 250,
    },
    "provider": "codestral",
  },
  "cli_default_open_behavior": "existing_window",
  "proxy": "",
  "zoomed_padding": true,
  "active_pane_modifiers": {
    "border_size": 0.0,
    "inactive_opacity": 1.0,
  },
  "use_system_window_tabs": false,
  "tabs": {
    "file_icons": true,
    "git_status": false,
  },
  "title_bar": {
    "button_layout": "platform_default",
    "show_menus": false,
    "show_user_menu": true,
    "show_sign_in": true,
    "show_onboarding_banner": true,
    "show_project_items": true,
    "show_branch_name": true,
    "show_branch_status_icon": false,
  },
  "terminal": {
    "toolbar": {
      "breadcrumbs": false,
    },
    "copy_on_select": true,
    "option_as_meta": false,
    "font_weight": 300.0,
    "font_size": 15.0,
    "show_count_badge": false,
    "button": true,
  },
  "status_bar": {
    "line_endings_button": false,
    "cursor_position_button": false,
    "active_language_button": true,
  },
  "project_panel": {
    "hide_hidden": false,
    "hide_root": true,
    "git_status_indicator": false,
    "diagnostic_badges": true,
    "bold_folder_labels": false,
    "indent_size": 20.0,
    "hide_gitignore": false,
    "button": true,
  },
  "inline_code_actions": false,
  "diagnostics": {
    "button": true,
    "inline": {
      "enabled": false,
    },
  },
  "inlay_hints": {
    "show_background": true,
    "enabled": false,
  },
  "indent_guides": {
    "background_coloring": "disabled",
    "coloring": "fixed",
    "active_line_width": 1,
    "line_width": 1,
  },
  "preferred_line_length": 110,
  "show_wrap_guides": true,
  "soft_wrap": "none",
  "vim": {
    "use_smartcase_find": true,
  },
  "toolbar": {
    "code_actions": true,
    "agent_review": true,
    "selections_menu": true,
    "breadcrumbs": true,
  },
  "minimap": {
    "thumb": "hover",
    "show": "auto",
  },
  "gutter": {
    "min_line_number_digits": 4,
    "line_numbers": true,
  },
  "autoscroll_on_clicks": true,
  "sticky_scroll": {
    "enabled": true,
  },
  "ui_font_weight": 400.0,
  "ui_font_family": "Exo",
  "buffer_line_height": "comfortable",
  "telemetry": {
    "diagnostics": true,
    "metrics": false,
    "anthropic_retention": false,
  },
  "icon_theme": {
    "mode": "light",
    "light": "Warm Charmed Icons",
    "dark": "Warm Charmed Icons",
  },
  "autosave": "on_focus_change",
  "format_on_save": "on",
  "buffer_font_weight": 300.0,
  "buffer_font_family": "SF Mono",
  "session": {
    "trust_all_worktrees": true,
  },
  "vim_mode": true,
  "multi_cursor_modifier": "cmd_or_ctrl",
  "ui_font_size": 16.0,
  "buffer_font_size": 15.0,
  "lsp": {
    "basedpyright": {
      "settings": {
        "basedpyright.analysis": {
          "diagnosticMode": "openFilesOnly",
          "typeCheckingMode": "basic",
        },
      },
    },
  },
  "theme": {
    "mode": "dark",
    "light": "Gruvbox Light Hard",
    "dark": "Catppuccin Frappé (Blur) [Heavy]",
  },
  "auto_install_extensions": {
    "catppuccin-blur": true,
    "charmed-icons": true,
    "git-firefly": true,
    "env": true,
    "lua": true,
    "rust-analyzer": true,
    "toml": true,
    "html": true,
    "dockerfile": true,
    "rainbow-csv": true,
    "sql": true,
    "make": true,
    "mcp-server-playwright": true,
  },
}
